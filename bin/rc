#!/usr/bin/env bash
# rc — remote coding session manager
#
# Manages coding sessions on the server:
#   1 session = 1 Docker container (sandbox) + 1 herdr workspace
#
# Commands:
#   rc new [branch] [repo]   new session: container + clone + herdr tab + Claude
#                            (omit repo = first repo in repos.conf)
#   rc issues [--dry-run] [repo]
#                            start a session for every open GitHub issue
#                            labeled "ready-for-agent" (branch issue-<NO>);
#                            skipped: sub-issues (issues with a parent) and
#                            issues already being worked on (running session
#                            or remote branch issue-<NO>*).
#                            --dry-run: only show what would start
#   rc ls                    list all sessions
#   rc attach [session]      open herdr (and focus that workspace if given)
#   rc claude <session>      start Claude (again) in the container
#   rc shell <session>       open a bash shell in the container
#   rc rm <session> [...]    end session(s): remove container, close workspace
#   rc rm --all              end all sessions
#   rc login [claude|codex]  renew a login (on "Login expired"), default claude;
#                            running sessions pick it up automatically
#   rc build                 build/update the Docker image
#   rc upgrade               git pull + rc build in one go
#
# Configuration under $RC_HOME (default: ~/.rc):
#   repos.conf         lines: "<name> <git-url>"
#   keys/<name>.key    deploy key (private part) per repo
#   seed/claude/       copy of ~/.claude taken after the Claude login
#   seed/claude.json   copy of ~/.claude.json
#   seed/codex/        copy of ~/.codex taken after the Codex login
#   seed/gh/           copy of ~/.config/gh taken after the gh login
#   auth/claude/       shared Claude credentials of all sessions
#   auth/codex/        shared Codex credentials of all sessions
#                      (mounted rw into every container; rc login writes
#                      here, the sessions sync themselves)
set -euo pipefail

RC_HOME="${RC_HOME:-$HOME/.rc}"
RC_IMAGE="${RC_IMAGE:-rc-session}"
REPOS_FILE="$RC_HOME/repos.conf"
SEED_DIR="$RC_HOME/seed"
KEYS_DIR="$RC_HOME/keys"
AUTH_DIR="$RC_HOME/auth"
# Resolve symlinks (rc is usually linked into ~/.local/bin)
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_PATH" ]; do
    _dir="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
    SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
    case "$SCRIPT_PATH" in
        /*) ;;
        *) SCRIPT_PATH="$_dir/$SCRIPT_PATH" ;;
    esac
done
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

die()  { echo "rc: $*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

usage() {
    # Print this script's header comment (up to the first non-comment line)
    awk 'NR > 1 { if (/^#/) { sub(/^# ?/, ""); print } else exit }' "$SCRIPT_PATH"
    exit 1
}

repo_url() {
    [ -f "$REPOS_FILE" ] || die "repo list missing: $REPOS_FILE"
    awk -v r="$1" '$1 == r { print $2; exit }' "$REPOS_FILE"
}

default_repo() {
    # First real repo in repos.conf (skip comments/blank lines)
    [ -f "$REPOS_FILE" ] || return 0
    awk '$1 !~ /^#/ && NF >= 2 { print $1; exit }' "$REPOS_FILE"
}

container_name() { echo "rc-$1"; }

repo_slug() {
    # Extract "owner/repo" from a git URL (ssh or https)
    echo "$1" | sed -E 's#^(git@[^:]+:|https?://[^/]+/)##; s#\.git$##'
}

resolve_repo() {
    # Determine the repo name: argument or default from repos.conf
    local repo="$1"
    if [ -z "$repo" ]; then
        repo="$(default_repo)"
        [ -n "$repo" ] || die "repos.conf is empty — no default repo ($REPOS_FILE)"
        echo "Repo: $repo (default)" >&2
    fi
    echo "$repo"
}

container_repo() {
    docker inspect -f '{{ index .Config.Labels "rc.repo" }}' "$(container_name "$1")" 2>/dev/null \
        || die "session '$1' not found (rc ls shows all)"
}

herdr_workspace_id() {
    # Find the workspace ID for a label (empty if not present).
    # "|| true": herdr may be installed but not running right now —
    # that must not abort rc because of "set -e".
    have herdr || return 0
    { herdr workspace list 2>/dev/null || true; } \
        | jq -r --arg l "$1" '.result.workspaces[]? | select(.label == $l) | .workspace_id' \
        | head -n1
}

claude_cmd() {
    local session="$1" repo="$2" prompt="${3:-}"
    # HERDR_AGENT tells herdr that this "wrapper" (docker exec) contains
    # Claude — otherwise the agent detection in the sidebar stays empty.
    # -u node: in Sysbox mode the container runs as root (for the inner
    # Docker) — but Claude should always run as a normal user.
    # auto instead of bypass: rarely asks, but risky commands (the container
    # holds the deploy key + gh login) show up as questions in Remote Control.
    local cmd="HERDR_AGENT=claude docker exec -it -u node -w /work/$repo $(container_name "$session") claude --permission-mode auto"
    # Optional start prompt; %q quotes it shell-safely (the string is
    # executed by a shell later: herdr pane run or eval)
    [ -n "$prompt" ] && cmd="$cmd $(printf '%q' "$prompt")"
    echo "$cmd"
}

cmd_build() {
    docker build -t "$RC_IMAGE" "$PROJECT_DIR/docker"
    echo "Image '$RC_IMAGE' built."
}

cmd_upgrade() {
    echo "Pulling latest version in $PROJECT_DIR ..."
    git -C "$PROJECT_DIR" pull --ff-only
    cmd_build
    echo "Done. Applies to new sessions (running ones keep the old image)."
}

cmd_new() {
    # Internal flags (used by rc issues): --no-attach = don't jump into herdr,
    # --prompt <text> = start Claude right away with this task
    local attach=1 prompt=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --no-attach) attach=0; shift ;;
            --prompt)    prompt="${2:-}"; shift 2 ;;
            *) break ;;
        esac
    done
    local branch="${1:-}" repo="${2:-}"
    repo="$(resolve_repo "$repo")"
    local url; url="$(repo_url "$repo")"
    [ -n "$url" ] || die "repo '$repo' is not listed in $REPOS_FILE"

    local key="$KEYS_DIR/$repo.key"
    [ -f "$key" ] || die "deploy key missing: $key"
    [ -d "$SEED_DIR/claude" ] || die "Claude seed missing: $SEED_DIR/claude (see README, step 'Logins')"

    # Shared credentials (Claude + Codex): one file for all sessions, so a
    # token refresh in one session doesn't invalidate the others. On the
    # very first run, take them from the host login if present.
    local pair shared_file host_file
    mkdir -p "$AUTH_DIR/claude" "$AUTH_DIR/codex"
    for pair in "claude/.credentials.json:$HOME/.claude/.credentials.json" \
                "codex/auth.json:$HOME/.codex/auth.json"; do
        shared_file="$AUTH_DIR/${pair%%:*}"
        host_file="${pair#*:}"
        if [ ! -f "$shared_file" ] && [ -f "$host_file" ]; then
            cp -p "$host_file" "$shared_file"
            chmod 600 "$shared_file"
            echo "Created shared credentials from the host login: $shared_file"
        fi
    done

    local session="$repo${branch:+-$branch}"
    session="$(echo "$session" | sed 's/[^a-zA-Z0-9-]/-/g')"
    local cname; cname="$(container_name "$session")"

    docker container inspect "$cname" >/dev/null 2>&1 \
        && die "session '$session' already exists (rc rm $session to clean up)"

    # Sysbox runtime available? Then the session gets its own inner Docker
    # (for Testcontainers). The container starts as root for that; the
    # entrypoint switches to the node user itself after starting dockerd.
    local runtime_args=()
    if docker info --format '{{json .Runtimes}}' 2>/dev/null | grep -q 'sysbox-runc'; then
        runtime_args=(--runtime=sysbox-runc -u 0)
    else
        echo "Warning: Sysbox is missing on the host — session without inner Docker (Testcontainers won't run)."
    fi

    echo "Starting container $cname ..."
    docker run -d --init --name "$cname" "${runtime_args[@]}" \
        --label "rc.session=$session" \
        --label "rc.repo=$repo" \
        -e REPO_URL="$url" \
        -e REPO_NAME="$repo" \
        -e BRANCH="$branch" \
        -v "$SEED_DIR":/seed:ro \
        -v "$AUTH_DIR":/auth \
        -v "$key":/deploy_key:ro \
        "$RC_IMAGE" >/dev/null

    echo -n "Waiting for clone "
    local ok=""
    for _ in $(seq 1 120); do
        if docker exec "$cname" test -f /work/.ready 2>/dev/null; then ok=1; break; fi
        if [ -z "$(docker ps -q -f "name=^${cname}\$")" ]; then
            echo; docker logs "$cname" | tail -n 20
            docker rm -f "$cname" >/dev/null
            die "container died during setup (log above)."
        fi
        echo -n "."; sleep 1
    done
    echo
    [ -n "$ok" ] || die "timeout during clone. Check the log with: docker logs $cname"

    if have herdr; then
        local ws pane ws_id
        if ws="$(herdr workspace create --cwd "$HOME" --label "$session" --no-focus 2>/dev/null)"; then
            pane="$(jq -r '.result.root_pane.pane_id' <<<"$ws")"
            herdr pane run "$pane" "$(claude_cmd "$session" "$repo" "$prompt")" >/dev/null
            echo "Session '$session' is running."
            [ "$attach" = 1 ] || return
            # Focus the workspace and jump right in
            ws_id="$(jq -r 'if (.result.workspace | type) == "object"
                            then .result.workspace.workspace_id
                            else .result.workspace end' <<<"$ws")"
            [ -n "$ws_id" ] && herdr workspace focus "$ws_id" >/dev/null 2>&1 || true
            if env | grep -q '^HERDR'; then
                return   # we're already inside herdr, focusing is enough
            fi
            exec herdr
        fi
        echo "Note: herdr is installed but not running (start 'herdr' once)."
    else
        echo "Note: herdr is not installed."
    fi
    echo "The container is running anyway. Start Claude directly with: rc claude $session"
}

cmd_issues() {
    # Start a session for every open issue labeled "ready-for-agent".
    # Skipped is anything visibly already in progress:
    #   - a session with "issue-<NO>" in its name exists (rc container), or
    #   - GitHub already has a branch "issue-<NO>..."
    #     (covers: session finished + removed, PR still open)
    local dry_run=0
    if [ "${1:-}" = "--dry-run" ]; then dry_run=1; shift; fi
    local repo="${1:-}"
    repo="$(resolve_repo "$repo")"
    local url; url="$(repo_url "$repo")"
    [ -n "$url" ] || die "repo '$repo' is not listed in $REPOS_FILE"
    have gh || die "gh is not installed on the host"
    local slug; slug="$(repo_slug "$url")"

    # GraphQL instead of "gh issue list": also returns each issue's parent —
    # sub-issues are ordinary issues and must not get their own session
    # (the parent's session takes care of the whole bundle)
    local issues
    issues="$(gh api graphql \
        -f owner="${slug%/*}" -f name="${slug#*/}" \
        -f query='query($owner: String!, $name: String!) {
            repository(owner: $owner, name: $name) {
                issues(states: OPEN, labels: ["ready-for-agent"], first: 100) {
                    nodes { number parent { number } }
                }
            }
        }' \
        --jq '.data.repository.issues.nodes[] | "\(.number)\t\(.parent.number // "")"')" \
        || die "could not load issues (GraphQL, repo $slug)"
    if [ -z "$issues" ]; then
        echo "No open issues labeled 'ready-for-agent' in $slug."
        return
    fi

    # Fetch both once up front instead of per issue: all sessions (stopped
    # ones too — their container name is still taken) and all remote branches
    local sessions branches
    sessions="$(docker ps -a --filter label=rc.session --format '{{.Label "rc.session"}}')"
    branches="$(gh api "repos/$slug/branches" --paginate --jq '.[].name' 2>/dev/null || true)"

    local n parent started=0
    while IFS=$'\t' read -r n parent; do
        [ -n "$n" ] || continue
        if [ -n "$parent" ]; then
            echo "Issue #$n: sub-issue of #$parent — skipped."
        elif grep -qE -- "-issue-$n(-|\$)" <<<"$sessions"; then
            echo "Issue #$n: session already running — skipped."
        elif grep -qE -- "^issue-$n(-|\$)" <<<"$branches"; then
            echo "Issue #$n: branch issue-$n already exists on GitHub — skipped."
        elif [ "$dry_run" = 1 ]; then
            echo "Issue #$n: would start a session (branch issue-$n)."
            started=$((started + 1))
        else
            echo "Issue #$n: starting session ..."
            cmd_new --no-attach \
                --prompt "Implement the GitHub Issue $n with the council." \
                "issue-$n" "$repo"
            started=$((started + 1))
        fi
    done <<<"$issues"
    if [ "$dry_run" = 1 ]; then
        echo "Dry run: $started session(s) would start, nothing was touched."
    else
        echo "Done: started $started new session(s)."
    fi
}

cmd_ls() {
    echo "== Containers =="
    docker ps -a --filter "label=rc.session" \
        --format 'table {{.Label "rc.session"}}\t{{.Status}}\t{{.Label "rc.repo"}}'
    if have herdr; then
        echo
        echo "== herdr workspaces =="
        herdr workspace list 2>/dev/null \
            | jq -r '.result.workspaces[]? | "\(.workspace_id)\t\(.label)"' \
            || echo "(herdr is not running right now)"
    fi
}

cmd_attach() {
    local session="${1:-}"
    have herdr || die "herdr is not installed"
    if [ -n "$session" ]; then
        local ws; ws="$(herdr_workspace_id "$session")"
        [ -n "$ws" ] && herdr workspace focus "$ws" >/dev/null 2>&1 || true
    fi
    exec herdr
}

cmd_claude() {
    local session="${1:-}"
    [ -n "$session" ] || usage
    local repo; repo="$(container_repo "$session")"
    eval "$(claude_cmd "$session" "$repo")"
}

cmd_shell() {
    local session="${1:-}"
    [ -n "$session" ] || usage
    local repo; repo="$(container_repo "$session")"
    docker exec -it -u node -w "/work/$repo" "$(container_name "$session")" bash
}

cmd_login() {
    # Renew the login on the host and make it available to all sessions.
    # Running sessions pick up the new file within ~15 s on their own
    # (sync loop in the container); no restart needed.
    local what="${1:-claude}" cred
    case "$what" in
    claude)
        have claude || die "claude is not installed on the host (npm install -g @anthropic-ai/claude-code)"
        echo "Claude will now start for the login. Quit Claude afterwards (/exit)."
        claude /login || true
        cred="$HOME/.claude/.credentials.json"
        [ -f "$cred" ] || die "no login found ($cred missing) — did the login work?"
        mkdir -p "$AUTH_DIR/claude"
        cp -p "$cred" "$AUTH_DIR/claude/.credentials.json"
        chmod 600 "$AUTH_DIR/claude/.credentials.json"
        # Update the seed too, so brand-new sessions start fresh as well
        if [ -d "$SEED_DIR/claude" ]; then
            cp -p "$cred" "$SEED_DIR/claude/.credentials.json"
        fi
        echo "Claude login distributed. Running sessions pick it up in about 15 seconds."
        echo "If a session still complains: quit Claude there and restart with 'claude -c'."
        ;;
    codex)
        have codex || die "codex is not installed on the host (npm install -g @openai/codex)"
        # --device-auth: the server is headless — enter the code in the
        # browser on your own machine instead of a localhost redirect
        # on the server
        codex login --device-auth || die "codex login failed"
        cred="$HOME/.codex/auth.json"
        [ -f "$cred" ] || die "no login found ($cred missing) — did the login work?"
        mkdir -p "$AUTH_DIR/codex"
        cp -p "$cred" "$AUTH_DIR/codex/auth.json"
        chmod 600 "$AUTH_DIR/codex/auth.json"
        if [ -d "$SEED_DIR/codex" ]; then
            cp -p "$cred" "$SEED_DIR/codex/auth.json"
        fi
        echo "Codex login distributed. Running sessions pick it up in about 15 seconds."
        ;;
    *)
        die "unknown login target '$what' (rc login [claude|codex])"
        ;;
    esac
}

cmd_rm() {
    if [ "${1:-}" = "--all" ]; then
        # Replace the arguments with every existing session
        set -- $(docker ps -a --filter label=rc.session --format '{{.Label "rc.session"}}')
        if [ $# -eq 0 ]; then
            echo "No sessions found."
            return
        fi
    fi
    [ $# -ge 1 ] || usage
    local session cname ws
    for session in "$@"; do
        cname="$(container_name "$session")"
        docker rm -f "$cname" >/dev/null 2>&1 && echo "Container $cname removed." \
            || echo "No container $cname (already gone?)."
        ws="$(herdr_workspace_id "$session")"
        if [ -n "$ws" ]; then
            herdr workspace close "$ws" >/dev/null 2>&1 && echo "herdr workspace '$session' closed."
        fi
    done
}

case "${1:-}" in
    new)    shift; cmd_new "$@" ;;
    issues) shift; cmd_issues "$@" ;;
    ls)     shift; cmd_ls "$@" ;;
    attach) shift; cmd_attach "$@" ;;
    claude) shift; cmd_claude "$@" ;;
    shell)  shift; cmd_shell "$@" ;;
    rm)     shift; cmd_rm "$@" ;;
    login)  shift; cmd_login "$@" ;;
    build)  shift; cmd_build "$@" ;;
    upgrade) shift; cmd_upgrade "$@" ;;
    *)      usage ;;
esac
