#!/usr/bin/env bash
# rc — remote coding session manager
#
# Verwaltet Coding-Sessions auf dem Server:
#   1 Session = 1 Docker-Container (Sandbox) + 1 herdr-Workspace
#
# Befehle:
#   rc new [branch] [repo]   neue Session: Container + Clone + herdr-Tab + Claude
#                            (repo weglassen = erstes Repo aus repos.conf)
#   rc ls                    alle Sessions anzeigen
#   rc attach [session]      herdr öffnen (und ggf. Workspace fokussieren)
#   rc claude <session>      Claude (nochmal) im Container starten
#   rc shell <session>       Bash im Container öffnen
#   rc rm <session> [...]    Session(s) beenden: Container weg, Workspace zu
#   rc login [claude|codex]  Login erneuern (bei "Login expired"), Default claude;
#                            laufende Sessions übernehmen ihn automatisch
#   rc build                 Docker-Image bauen/aktualisieren
#   rc upgrade               git pull + rc build in einem Rutsch
#
# Konfiguration unter $RC_HOME (Default: ~/.rc):
#   repos.conf         Zeilen: "<name> <git-url>"
#   keys/<name>.key    Deploy-Key (privater Teil) pro Repo
#   seed/claude/       Kopie von ~/.claude nach dem Claude-Login
#   seed/claude.json   Kopie von ~/.claude.json
#   seed/codex/        Kopie von ~/.codex nach dem Codex-Login
#   seed/gh/           Kopie von ~/.config/gh nach dem gh-Login
#   auth/claude/       geteilte Claude-Credentials aller Sessions
#   auth/codex/        geteilte Codex-Credentials aller Sessions
#                      (rw in jeden Container gemountet; rc login schreibt
#                      hierher, die Sessions syncen sich selbst)
set -euo pipefail

RC_HOME="${RC_HOME:-$HOME/.rc}"
RC_IMAGE="${RC_IMAGE:-rc-session}"
REPOS_FILE="$RC_HOME/repos.conf"
SEED_DIR="$RC_HOME/seed"
KEYS_DIR="$RC_HOME/keys"
AUTH_DIR="$RC_HOME/auth"
# Symlinks auflösen (rc liegt z.B. als Link in ~/.local/bin)
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_PATH" ]; do
    _dir="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
    SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
    case "$SCRIPT_PATH" in
        /*) ;;
        *) SCRIPT_PATH="$_dir/$SCRIPT_PATH" ;;
    esac
done
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

die()  { echo "rc: $*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

usage() {
    # Kopf-Kommentar dieses Skripts ausgeben (bis zur ersten Nicht-Kommentar-Zeile)
    awk 'NR > 1 { if (/^#/) { sub(/^# ?/, ""); print } else exit }' "$SCRIPT_PATH"
    exit 1
}

repo_url() {
    [ -f "$REPOS_FILE" ] || die "Repo-Liste fehlt: $REPOS_FILE"
    awk -v r="$1" '$1 == r { print $2; exit }' "$REPOS_FILE"
}

default_repo() {
    # Erstes echtes Repo in repos.conf (Kommentare/Leerzeilen überspringen)
    [ -f "$REPOS_FILE" ] || return 0
    awk '$1 !~ /^#/ && NF >= 2 { print $1; exit }' "$REPOS_FILE"
}

container_name() { echo "rc-$1"; }

container_repo() {
    docker inspect -f '{{ index .Config.Labels "rc.repo" }}' "$(container_name "$1")" 2>/dev/null \
        || die "Session '$1' nicht gefunden (rc ls zeigt alle)"
}

herdr_workspace_id() {
    # Workspace-ID zu einem Label finden (leer, wenn nicht vorhanden).
    # "|| true": herdr kann installiert sein, aber gerade nicht laufen —
    # das darf rc wegen "set -e" nicht abbrechen.
    have herdr || return 0
    { herdr workspace list 2>/dev/null || true; } \
        | jq -r --arg l "$1" '.result.workspaces[]? | select(.label == $l) | .workspace_id' \
        | head -n1
}

claude_cmd() {
    local session="$1" repo="$2"
    # HERDR_AGENT sagt herdr, dass in diesem "Wrapper" (docker exec) Claude
    # steckt — sonst bleibt die Agenten-Erkennung in der Sidebar leer.
    # -u node: im Sysbox-Modus läuft der Container als root (fürs innere
    # Docker) — Claude soll aber immer als normaler User laufen.
    # auto statt bypass: fragt praktisch nie, aber riskante Befehle (der
    # Container hat Deploy-Key + gh-Login) landen als Frage im Remote Control.
    echo "HERDR_AGENT=claude docker exec -it -u node -w /work/$repo $(container_name "$session") claude --permission-mode auto"
}

cmd_build() {
    docker build -t "$RC_IMAGE" "$PROJECT_DIR/docker"
    echo "Image '$RC_IMAGE' gebaut."
}

cmd_upgrade() {
    echo "Hole neuesten Stand in $PROJECT_DIR ..."
    git -C "$PROJECT_DIR" pull --ff-only
    cmd_build
    echo "Fertig. Gilt für neue Sessions (laufende behalten das alte Image)."
}

cmd_new() {
    local branch="${1:-}" repo="${2:-}"
    if [ -z "$repo" ]; then
        repo="$(default_repo)"
        [ -n "$repo" ] || die "repos.conf ist leer — kein Default-Repo ($REPOS_FILE)"
        echo "Repo: $repo (Default)"
    fi
    local url; url="$(repo_url "$repo")"
    [ -n "$url" ] || die "Repo '$repo' steht nicht in $REPOS_FILE"

    local key="$KEYS_DIR/$repo.key"
    [ -f "$key" ] || die "Deploy-Key fehlt: $key"
    [ -d "$SEED_DIR/claude" ] || die "Claude-Seed fehlt: $SEED_DIR/claude (siehe README, Schritt 'Logins')"

    # Geteilte Credentials (Claude + Codex): eine Datei für alle Sessions,
    # damit ein Token-Refresh in einer Session nicht die anderen ungültig
    # macht. Beim allerersten Mal vom Host-Login übernehmen, falls vorhanden.
    local pair shared_file host_file
    mkdir -p "$AUTH_DIR/claude" "$AUTH_DIR/codex"
    for pair in "claude/.credentials.json:$HOME/.claude/.credentials.json" \
                "codex/auth.json:$HOME/.codex/auth.json"; do
        shared_file="$AUTH_DIR/${pair%%:*}"
        host_file="${pair#*:}"
        if [ ! -f "$shared_file" ] && [ -f "$host_file" ]; then
            cp -p "$host_file" "$shared_file"
            chmod 600 "$shared_file"
            echo "Geteilte Credentials aus dem Host-Login angelegt: $shared_file"
        fi
    done

    local session="$repo${branch:+-$branch}"
    session="$(echo "$session" | sed 's/[^a-zA-Z0-9-]/-/g')"
    local cname; cname="$(container_name "$session")"

    docker container inspect "$cname" >/dev/null 2>&1 \
        && die "Session '$session' existiert schon (rc rm $session zum Aufräumen)"

    # Sysbox-Runtime da? Dann bekommt die Session ihr eigenes inneres Docker
    # (für Testcontainers). Container startet dafür als root; der Entrypoint
    # wechselt nach dem dockerd-Start selbst zum User node.
    local runtime_args=()
    if docker info --format '{{json .Runtimes}}' 2>/dev/null | grep -q 'sysbox-runc'; then
        runtime_args=(--runtime=sysbox-runc -u 0)
    else
        echo "Warnung: Sysbox fehlt auf dem Host — Session ohne inneres Docker (Testcontainers laufen nicht)."
    fi

    echo "Starte Container $cname ..."
    docker run -d --init --name "$cname" "${runtime_args[@]}" \
        --label "rc.session=$session" \
        --label "rc.repo=$repo" \
        -e REPO_URL="$url" \
        -e REPO_NAME="$repo" \
        -e BRANCH="$branch" \
        -v "$SEED_DIR":/seed:ro \
        -v "$AUTH_DIR":/auth \
        -v "$key":/deploy_key:ro \
        "$RC_IMAGE" >/dev/null

    echo -n "Warte auf Clone "
    local ok=""
    for _ in $(seq 1 120); do
        if docker exec "$cname" test -f /work/.ready 2>/dev/null; then ok=1; break; fi
        if [ -z "$(docker ps -q -f "name=^${cname}\$")" ]; then
            echo; docker logs "$cname" | tail -n 20
            docker rm -f "$cname" >/dev/null
            die "Container ist beim Setup gestorben (Log oben)."
        fi
        echo -n "."; sleep 1
    done
    echo
    [ -n "$ok" ] || die "Timeout beim Clone. Log ansehen mit: docker logs $cname"

    if have herdr; then
        local ws pane ws_id
        if ws="$(herdr workspace create --cwd "$HOME" --label "$session" --no-focus 2>/dev/null)"; then
            pane="$(jq -r '.result.root_pane.pane_id' <<<"$ws")"
            herdr pane run "$pane" "$(claude_cmd "$session" "$repo")" >/dev/null
            # Workspace fokussieren und direkt reinspringen
            ws_id="$(jq -r 'if (.result.workspace | type) == "object"
                            then .result.workspace.workspace_id
                            else .result.workspace end' <<<"$ws")"
            [ -n "$ws_id" ] && herdr workspace focus "$ws_id" >/dev/null 2>&1 || true
            echo "Session '$session' läuft."
            if env | grep -q '^HERDR'; then
                return   # wir sind schon in herdr, Fokus reicht
            fi
            exec herdr
        fi
        echo "Hinweis: herdr ist installiert, läuft aber nicht (einmal 'herdr' starten)."
    else
        echo "Hinweis: herdr ist nicht installiert."
    fi
    echo "Container läuft trotzdem. Claude direkt starten mit: rc claude $session"
}

cmd_ls() {
    echo "== Container =="
    docker ps -a --filter "label=rc.session" \
        --format 'table {{.Label "rc.session"}}\t{{.Status}}\t{{.Label "rc.repo"}}'
    if have herdr; then
        echo
        echo "== herdr-Workspaces =="
        herdr workspace list 2>/dev/null \
            | jq -r '.result.workspaces[]? | "\(.workspace_id)\t\(.label)"' \
            || echo "(herdr läuft gerade nicht)"
    fi
}

cmd_attach() {
    local session="${1:-}"
    have herdr || die "herdr ist nicht installiert"
    if [ -n "$session" ]; then
        local ws; ws="$(herdr_workspace_id "$session")"
        [ -n "$ws" ] && herdr workspace focus "$ws" >/dev/null 2>&1 || true
    fi
    exec herdr
}

cmd_claude() {
    local session="${1:-}"
    [ -n "$session" ] || usage
    local repo; repo="$(container_repo "$session")"
    eval "$(claude_cmd "$session" "$repo")"
}

cmd_shell() {
    local session="${1:-}"
    [ -n "$session" ] || usage
    local repo; repo="$(container_repo "$session")"
    docker exec -it -u node -w "/work/$repo" "$(container_name "$session")" bash
}

cmd_login() {
    # Login auf dem Host erneuern und für alle Sessions bereitstellen.
    # Laufende Sessions übernehmen die neue Datei binnen ~15 s von selbst
    # (Sync-Loop im Container); Neustart ist nicht nötig.
    local what="${1:-claude}" cred
    case "$what" in
    claude)
        have claude || die "claude ist auf dem Host nicht installiert (npm install -g @anthropic-ai/claude-code)"
        echo "Claude startet jetzt für den Login. Danach Claude beenden (/exit)."
        claude /login || true
        cred="$HOME/.claude/.credentials.json"
        [ -f "$cred" ] || die "Kein Login gefunden ($cred fehlt) — hat der Login geklappt?"
        mkdir -p "$AUTH_DIR/claude"
        cp -p "$cred" "$AUTH_DIR/claude/.credentials.json"
        chmod 600 "$AUTH_DIR/claude/.credentials.json"
        # Seed mitziehen, damit auch ganz neue Sessions frisch starten
        if [ -d "$SEED_DIR/claude" ]; then
            cp -p "$cred" "$SEED_DIR/claude/.credentials.json"
        fi
        echo "Claude-Login verteilt. Laufende Sessions übernehmen ihn in ca. 15 Sekunden."
        echo "Falls eine Session weiter meckert: Claude dort beenden und mit 'claude -c' neu starten."
        ;;
    codex)
        have codex || die "codex ist auf dem Host nicht installiert (npm install -g @openai/codex)"
        # --device-auth: der Server ist headless — Code am eigenen Rechner
        # im Browser eingeben statt localhost-Redirect auf dem Server
        codex login --device-auth || die "codex login ist fehlgeschlagen"
        cred="$HOME/.codex/auth.json"
        [ -f "$cred" ] || die "Kein Login gefunden ($cred fehlt) — hat der Login geklappt?"
        mkdir -p "$AUTH_DIR/codex"
        cp -p "$cred" "$AUTH_DIR/codex/auth.json"
        chmod 600 "$AUTH_DIR/codex/auth.json"
        if [ -d "$SEED_DIR/codex" ]; then
            cp -p "$cred" "$SEED_DIR/codex/auth.json"
        fi
        echo "Codex-Login verteilt. Laufende Sessions übernehmen ihn in ca. 15 Sekunden."
        ;;
    *)
        die "Unbekanntes Login-Ziel '$what' (rc login [claude|codex])"
        ;;
    esac
}

cmd_rm() {
    [ $# -ge 1 ] || usage
    local session cname ws
    for session in "$@"; do
        cname="$(container_name "$session")"
        docker rm -f "$cname" >/dev/null 2>&1 && echo "Container $cname entfernt." \
            || echo "Kein Container $cname (schon weg?)."
        ws="$(herdr_workspace_id "$session")"
        if [ -n "$ws" ]; then
            herdr workspace close "$ws" >/dev/null 2>&1 && echo "herdr-Workspace '$session' geschlossen."
        fi
    done
}

case "${1:-}" in
    new)    shift; cmd_new "$@" ;;
    ls)     shift; cmd_ls "$@" ;;
    attach) shift; cmd_attach "$@" ;;
    claude) shift; cmd_claude "$@" ;;
    shell)  shift; cmd_shell "$@" ;;
    rm)     shift; cmd_rm "$@" ;;
    login)  shift; cmd_login "$@" ;;
    build)  shift; cmd_build "$@" ;;
    upgrade) shift; cmd_upgrade "$@" ;;
    *)      usage ;;
esac
